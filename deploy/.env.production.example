# ── Bank For All production configuration ──────────────────────────────────────────
# Copy to .env.production (chmod 600). Never commit the filled-in file.
# Generate secrets with:  openssl rand -hex 32   (APP_ENCRYPTION_KEY: openssl rand -base64 32)
# Only letters/digits in passwords (they are written into config files).
# Each service receives only the variables it needs — see docker-compose.prod.yml.

# Release to run (images from .github/workflows/release.yml). Pin a version tag in production.
IMAGE_TAG=latest
IMAGE_REGISTRY=ghcr.io/bankforall

# Public site
DOMAIN=app.example.co.th
ACME_EMAIL=ops@example.co.th
PUBLIC_URL=https://app.example.co.th
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Datastores (containers on the private compose network)
POSTGRES_PASSWORD=
# write the passwords literally (no ${...} expansion inside this file)
DATABASE_URL=postgresql://bankforall:<POSTGRES_PASSWORD>@postgres:5432/bankforall
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=bankforall
S3_ACCESS_KEY=bankforall
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Secrets — losing APP_ENCRYPTION_KEY makes stored KYC files, slips and bids unreadable: back it up offline
SESSION_SECRET=
APP_ENCRYPTION_KEY=
HMAC_KEY=

# LINE Login channel + Messaging API channel (developers.line.biz)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=
DEV_LOGIN=false

# SMS for OTP (api only). thaibulksms (Thai sender ID, THB billing) or twilio
SMS_PROVIDER=thaibulksms
# ThaiBulkSMS: dashboard > Setting > API Key. SENDER must be a sender name approved on the account.
# FORCE: standard | corporate (empty = the type set in the dashboard; OTP usually uses corporate)
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
THAIBULKSMS_SENDER=
THAIBULKSMS_FORCE=corporate
# Twilio (only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Admin 2FA: passkeys (WebAuthn) on top of LINE login, always required in production.
# RP ID = the hostname admins open (same as DOMAIN); ORIGIN = exactly PUBLIC_URL (https, no path).
# Changing WEBAUTHN_RP_ID later invalidates every registered admin passkey.
WEBAUTHN_RP_ID=app.example.co.th
WEBAUTHN_ORIGIN=https://app.example.co.th
# Seconds an admin stays verified after a passkey prompt (60–3600).
ADMIN_STEPUP_TTL=900

# Chain — Base mainnet (8453). For staging use Base Sepolia: CHAIN_ID=84532, EXPLORER_URL=https://sepolia.basescan.org
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
EXPLORER_URL=https://basescan.org
# from packages/contracts/deployments/<chainId>.json
FACTORY_ADDRESS=
FORWARDER_ADDRESS=
DEPLOY_BLOCK=
CONFIRMATIONS=3
# Three DIFFERENT hot keys, each given to one container only:
#   relayer → api (pays gas for users' signed requests), keeper → worker (time-based actions),
#   attester → signer (KYC statements, key rotations, slip attestations; holds ATTESTER_ROLE).
# Relayer and keeper pay gas: keep ~0.01 ETH each, top up when /api/health reports gasLow.
RELAYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
MIN_GAS_BALANCE_WEI=3000000000000000

# Internal signer service (api/worker → signer). Random, at least 32 characters.
SIGNER_TOKEN=
# Waiting time between the second admin approval and an account key switch.
KEY_ROTATION_DELAY_HOURS=24

# Backups (deploy/backup.sh) are encrypted with this passphrase — store it OUTSIDE this server.
BACKUP_PASSPHRASE=

WORKER_INTERVAL_MS=5000

# Automatic slip verification (worker only). none = the recipient's confirmation decides.
# slipok: SlipOK (slipok.com) branch id + API key. Only the slip image and the amount are sent.
SLIP_VERIFIER=none
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
# provider errors per slip before giving up (SKIPPED + alert); backoff 1,2,4…60 min
SLIP_VERIFY_MAX_ATTEMPTS=8

# ── Operations: alerts + heartbeat (docs/v2/deployment.md) ──
# Webhook for ALERT: events (api, worker, signer). FORMAT: slack | discord | json
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=slack
# Optional: also push alerts to a LINE group (group id "C…"; the official account must be in the group).
# Uses LINE_MESSAGING_TOKEN above; api + worker only.
ALERT_LINE_TO=
# The same alert is sent at most once per this many minutes
ALERT_THROTTLE_MINUTES=30
# Alert when a worker job fails this many loops in a row
ALERT_JOB_FAILURES=5
# Alert when the indexer is this many blocks behind (Base ≈ 2 s/block → 300 ≈ 10 min)
INDEXER_LAG_ALERT_BLOCKS=300
# Push-style uptime monitor pinged by the worker after each successful loop (max once a minute),
# e.g. https://hc-ping.com/<uuid> or https://uptime.example.com/api/push/<token>
HEARTBEAT_URL=
