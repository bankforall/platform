# ── Bank For All production configuration ──────────────────────────────────────────
# Copy to .env.production (chmod 600). Never commit the filled-in file.
# Generate secrets with:  openssl rand -hex 32   (APP_ENCRYPTION_KEY: openssl rand -base64 32)
# Only letters/digits in passwords (they are written into config files).
# Each service receives only the variables it needs — see docker-compose.prod.yml.

# Release to run (images from .github/workflows/release.yml). Pin a version tag in production.
IMAGE_TAG=latest
IMAGE_REGISTRY=ghcr.io/bankforall

# User-visible product name (web build + SMS/evidence report). Empty = "Bank For All".
# The final name is pending legal review ("Bank" may be restricted in Thailand).
APP_NAME=
APP_SHORT_NAME=

# Public site
DOMAIN=app.example.co.th
ACME_EMAIL=ops@example.co.th
PUBLIC_URL=https://app.example.co.th
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Datastores (containers on the private compose network)
POSTGRES_PASSWORD=
# write the passwords literally (no ${...} expansion inside this file)
DATABASE_URL=postgresql://bankforall:<POSTGRES_PASSWORD>@postgres:5432/bankforall
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=bankforall
S3_ACCESS_KEY=bankforall
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Secrets — losing APP_ENCRYPTION_KEY makes stored KYC files, slips and bids unreadable: back it up offline
SESSION_SECRET=
APP_ENCRYPTION_KEY=
HMAC_KEY=

# LINE Login channel + Messaging API channel (developers.line.biz)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=
DEV_LOGIN=false

# SMS for OTP
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Chain — Base mainnet (8453). For staging use Base Sepolia: CHAIN_ID=84532, EXPLORER_URL=https://sepolia.basescan.org
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
EXPLORER_URL=https://basescan.org
# from packages/contracts/deployments/<chainId>.json
FACTORY_ADDRESS=
FORWARDER_ADDRESS=
DEPLOY_BLOCK=
CONFIRMATIONS=3
# Three DIFFERENT hot keys, each given to one container only:
#   relayer → api (pays gas for users' signed requests), keeper → worker (time-based actions),
#   attester → signer (KYC statements, key rotations, slip attestations; holds ATTESTER_ROLE).
# Relayer and keeper pay gas: keep ~0.01 ETH each, top up when /api/health reports gasLow.
RELAYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
MIN_GAS_BALANCE_WEI=3000000000000000

# Internal signer service (api/worker → signer). Random, at least 32 characters.
SIGNER_TOKEN=
# Waiting time between the second admin approval and an account key switch.
KEY_ROTATION_DELAY_HOURS=24

# PDPA account deletion: cooling-off before anonymising (user can cancel), and how long slips of a
# deleted account stay as evidence for the other members after the circle ended (keep in sync with docs/legal/privacy-th.md).
ACCOUNT_DELETION_DELAY_DAYS=7
DELETED_SLIP_RETENTION_DAYS=3650

# Backups (deploy/backup.sh) are encrypted with this passphrase — store it OUTSIDE this server.
BACKUP_PASSPHRASE=

SLIP_VERIFIER=none
WORKER_INTERVAL_MS=5000
