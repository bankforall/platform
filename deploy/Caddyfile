# Serves the PWA and proxies /api to the API container. Caddy obtains and renews the TLS
# certificate for {$DOMAIN} automatically (ports 80/443 must reach this host).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(), microphone=(), publickey-credentials-create=(self), publickey-credentials-get=(self)"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000 {
			health_uri /api/health
			health_interval 15s
		}
	}

	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://profile.line-scdn.net https://*.line-scdn.net; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://access.line.me"
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
